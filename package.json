{
  "name": "atlas-valley-ecosystem",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run compile --workspace contracts && bash ./scripts/dev.sh",
    "dev:contracts": "npm run dev --workspace contracts",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace contracts && npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace contracts",
    "setup": "bash ./scripts/setup.sh",
    "bootstrap": "bash ./scripts/bootstrap.sh"
  }
}